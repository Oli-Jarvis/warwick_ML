{
    "run_type": "staged_learning",
    "device": "cpu",
    "use_cuda": true,
    "tb_logdir": "tb_logs",
    "json_out_config": "_staged_learning.json",
    "seed": null,
    "parameters": {
        "prior_file": "ggs_dataset.checkpoint",
        "agent_file": "ggs_dataset.checkpoint",
        "summary_csv_prefix": "staged_learning",
        "use_checkpoint": false,
        "purge_memories": false,
        "smiles_file": null,
        "sample_strategy": "multinomial",
        "distance_threshold": 99999,
        "batch_size": 64,
        "randomize_smiles": true,
        "unique_sequences": false,
        "temperature": 1.0,
        "tb_isim": false
    },
    "scoring": null,
    "scheduler": null,
    "responder": null,
    "filter": null,
    "stage": [
        {
            "max_steps": 1000,
            "max_score": 1.0,
            "chkpt_file": "test1_upconversion.chkpt",
            "termination": "simple",
            "min_steps": 50,
            "scoring": {
                "type": "geometric_mean",
                "component": [
                    {
                        "nmo": {
                            "endpoint": [
                                {
                                    "name": "upconversion",
                                    "weight": 1,
                                    "params": {
                                        "config_path": "configs/nmo_upconversion.ini"
                                    }
                                }
                            ]
                        }
                    }
                ],
                "filename": null
            },
            "diversity_filter": null
        }
    ],
    "learning_strategy": {
        "type": "dap",
        "sigma": 128,
        "rate": 0.0001
    },
    "diversity_filter": {
        "type": "IdenticalMurckoScaffold",
        "bucket_size": 25,
        "minscore": 0.2,
        "minsimilarity": 0.4,
        "penalty_multiplier": 0.5
    },
    "intrinsic_penalty": null,
    "inception": {
        "smiles_file": null,
        "memory_size": 100,
        "sample_size": 10,
        "deduplicate": true
    }
}