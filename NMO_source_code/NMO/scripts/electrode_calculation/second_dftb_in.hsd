
Geometry = vaspFormat {
    <<< "POSCAR"
}

Hamiltonian = xTB {
    Method = "GFN1-xTB"
    KPointsAndWeights = SupercellFolding {
      4 0 0
      0 4 0
      0 0 4
      0.0 0.0 0.0
    }
    ReadInitialCharges = Yes
}
Options = {
    WriteHS = Yes
}
Analysis = {
    WriteEigenvectors = Yes
    EigenvectorsAsText = Yes
}
